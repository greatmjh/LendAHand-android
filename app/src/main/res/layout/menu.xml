<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    tools:content=".menuActivity">

    <ImageButton
        android:id="@+id/backButton1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        style="@style/icon"
        android:onClick="backOnClick"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/actionModeCloseDrawable" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingVertical="9dp"
        android:text="@string/menu_subtitle_general"
        android:textColor="@color/md_theme_outline"
        android:textStyle="bold" />

    <View
        android:id="@+id/divider12"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/notificationMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/notifications"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider5"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/topDonorsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/top_donors"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider9"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="9dp"
        android:text="@string/make_donations"
        android:textColor="@color/md_theme_outline"
        android:textStyle="bold" />

    <View
        android:id="@+id/divider6"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/manageDonationsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/manage_my_donations"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider13"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/reqReceivedMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/manage_my_incoming_requests"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider7"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/highlyRequestedItemsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/view_highly_requested_items"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider10"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="24dp"
        android:paddingBottom="9dp"
        android:text="@string/receive_donations"
        android:textColor="@color/md_theme_outline"
        android:textStyle="bold" />

    <View
        android:id="@+id/divider14"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/findDonationsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/find_donations"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider8"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/manageRequestsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/manage_my_outgoing_requests"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/manageUniversalRequestsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="@string/manage_my_universal_requests"
        android:textSize="14sp" />

    <View
        android:id="@+id/divider11"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider"
        android:paddingHorizontal="18dp" />

    <TextView
        android:id="@+id/logOutMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:onClick="menuClick"
        android:paddingHorizontal="24dp"
        android:paddingVertical="40dp"
        android:text="@string/log_out"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>