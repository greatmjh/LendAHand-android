<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SignUpPage">

    <TextView
        android:id="@+id/signUpHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="Sign Up"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/fullNameEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="100dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Enter your Full Name"
        android:includeFontPadding="true"
        android:inputType="text"
        android:text="Full Name"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/bioEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Tell us a little bit about yourself..."
        android:includeFontPadding="true"
        android:inputType="text|textLongMessage"
        android:text="Bio"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phoneEntry" />

    <EditText
        android:id="@+id/passwordEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Enter a strong password"
        android:includeFontPadding="true"
        android:inputType="text|textPassword"
        android:text="Password"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bioEntry" />

    <EditText
        android:id="@+id/confirmPasswordEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Enter a strong password"
        android:includeFontPadding="true"
        android:inputType="text|textPassword"
        android:text="Confirm Password"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordEntry" />

    <EditText
        android:id="@+id/emailEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Enter your Email Address"
        android:includeFontPadding="true"
        android:inputType="text|textEmailAddress"
        android:text="Email Address"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fullNameEntry" />

    <EditText
        android:id="@+id/phoneEntry"
        android:layout_width="335dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="#BFBFBF"
        android:ems="10"
        android:hint="Enter your Phone Number"
        android:includeFontPadding="true"
        android:inputType="phone"
        android:text="Phone Number"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailEntry" />

    <Button
        android:id="@+id/signUpButton"
        android:layout_width="96dp"
        android:layout_height="42dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="14dp"
        android:text="Sign Up"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirmPasswordEntry" />

    <Button
        android:id="@+id/altloginButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#BABABA"
        android:text="Have an account? Log in"
        android:textColor="#313131"
        android:textColorLink="#FBFBFB"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/signUpButton"
        app:layout_constraintTop_toBottomOf="@+id/confirmPasswordEntry" />
</androidx.constraintlayout.widget.ConstraintLayout>