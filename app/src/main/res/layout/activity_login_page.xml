<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foregroundTint="#00C3AFAF"
    tools:context=".loginPage">

    <TextView
        android:id="@+id/logInHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="@string/log_in"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/emailEntryLogin"
        android:layout_width="335dp"
        android:layout_height="52dp"
        android:layout_marginTop="100dp"
        android:background="@color/md_theme_surfaceDim"
        android:ems="10"
        android:includeFontPadding="true"
        android:inputType="text|textEmailAddress"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/passwordEntryLogin"
        android:layout_width="335dp"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@color/md_theme_surfaceDim"
        android:ems="10"
        android:includeFontPadding="true"
        android:inputType="text|textPassword"
        android:textAlignment="textStart"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailEntryLogin" />

    <TextView
        android:id="@+id/itemNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="@string/password"
        android:textSize="12sp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        app:layout_constraintStart_toStartOf="@+id/passwordEntryLogin"
        app:layout_constraintTop_toTopOf="@+id/passwordEntryLogin" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="96dp"
        android:layout_height="42dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="14dp"
        android:onClick="logInClick"
        android:text="@string/log_in"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passwordEntryLogin" />

    <Button
        android:id="@+id/altsignUpButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/md_theme_surfaceDim"
        android:onClick="signUpClick"
        android:text="@string/don_t_have_an_account_sign_up"
        android:textColor="@color/md_theme_scrim"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/loginButton"
        app:layout_constraintTop_toBottomOf="@+id/passwordEntryLogin" />

    <Button
        android:id="@+id/forgotPassButton"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/md_theme_surfaceDim"
        android:onClick="forgotPassClick"
        android:text="@string/forgot_password"
        android:textColor="@color/md_theme_scrim"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loginButton" />

    <TextView
        android:id="@+id/emailAddText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:text="@string/email_address"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/emailEntryLogin"
        app:layout_constraintTop_toTopOf="@+id/emailEntryLogin" />

</androidx.constraintlayout.widget.ConstraintLayout>