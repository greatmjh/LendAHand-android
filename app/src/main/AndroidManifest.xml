<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

<application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LendAHand"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".screens.AppLauncher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".screens.find_donations.MakeRequestPopup"
            android:exported="false"
            android:theme="@style/PopupTheme"
            android:noHistory="true"/>
        <activity
            android:name=".screens.highly_requested_items.HighlyRequestedItems"
            android:exported="true" />
        <activity
            android:name=".screens.find_donations.FindDonations"
            android:exported="false" />
        <activity
            android:name=".screens.notifications.Notifications"
            android:exported="true" />
        <activity
            android:name=".screens.make_gen_requests.MakeGenRequest"
            android:exported="true" />
        <activity
            android:name=".screens.manage_requests.ManageRequests"
            android:exported="true" />
        <activity
            android:name=".screens.manage_my_donations.MakeDonation"
            android:exported="true" />
        <activity
            android:name=".screens.manage_my_donations.ManageMyDonations"
            android:exported="true" />
        <activity
            android:name=".screens.requests_received.RequestsReceived"
            android:exported="true" />
        <activity
            android:name=".screens.ViewProfile"
            android:exported="true" />
        <activity
            android:name=".screens.ProfileSettings"
            android:exported="true"
            android:theme="@style/Theme.LendAHand" />
        <activity
            android:name=".screens.requests_received.ViewRequestDonor"
            android:exported="true" />
        <activity
            android:name=".screens.top_donors.topDonors"
            android:exported="true" />
        <activity
            android:name=".screens.ChangePassword"
            android:exported="true" />
        <activity
            android:name=".screens.LoginPage"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".screens.SignUpPage"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".screens.MenuActivity"
            android:exported="true" />
        <activity
            android:name=".screens.find_donations.WelcomePage"
            android:exported="true">

        </activity>


    </application>

</manifest>